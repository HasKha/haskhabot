# Copy to .env and fill in. Never commit .env.

# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Channel pairs and signup-reaction channels live in config.json (copy config.example.json).
# Right-click a channel -> Copy Channel ID (needs Developer Mode on).
# Path to it, relative to the working directory:
# CONFIG_FILE=config.json

# How many lines of each post to show in the list
PREVIEW_LINES=3

# How many past messages to scan on startup; empty = the whole channel
HISTORY_LIMIT=

# How long an event stays in the list after its start time
KEEP_AFTER_START_HOURS=4
